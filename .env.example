# Copy to .env and fill in. Never commit .env.

# Job source provider (adapter). Currently available: jobgpt, greenhouse, lever.
# Future sources plug in behind the same interface.
# Run several at once with the comma-separated JOB_SOURCES list, or on the CLI:
#   python -m job_agent run --sources greenhouse,lever
#   python -m job_agent run --all-sources
JOB_SOURCE=jobgpt
# JOB_SOURCES=greenhouse,lever

# Optional JobGPT credential (only needed when JOB_SOURCE=jobgpt).
# Generate at https://6figr.com/account -> MCP Integrations
JOBGPT_API_KEY=
JOBGPT_API_URL=https://6figr.com

# Greenhouse public job board (only needed when JOB_SOURCE=greenhouse).
# Board token = the slug on the company's careers URL: boards.greenhouse.io/<board_token>
GREENHOUSE_BOARD=
GREENHOUSE_API_URL=https://boards-api.greenhouse.io/v1

# Lever public job postings (only needed when JOB_SOURCE=lever).
# Company = the slug on the careers site: jobs.lever.co/<company> (e.g. lever)
LEVER_COMPANY=
LEVER_API_URL=https://api.lever.co/v0

# LLM provider for AI-dependent features (tailoring, drafting, semantic matching).
# none = deterministic-only mode. First-class optional local option: ollama
LLM_PROVIDER=none

# Ollama (used only when LLM_PROVIDER=ollama and a local daemon is running)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2