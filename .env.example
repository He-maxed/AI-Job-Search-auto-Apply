# Copy to .env and fill in. Never commit .env.

# Job source provider (adapter). Currently available: jobgpt, greenhouse, lever,
# ashby, remotive, jobicy, adzuna.
# Future sources plug in behind the same interface.
# Run several at once with the comma-separated JOB_SOURCES list, or on the CLI:
#   python -m job_agent run --sources greenhouse,lever,ashby,remotive,jobicy
#   python -m job_agent run --all-sources
JOB_SOURCE=jobgpt
# JOB_SOURCES=greenhouse,lever,ashby

# Optional JobGPT credential (only needed when JOB_SOURCE=jobgpt).
# Generate at https://6figr.com/account -> MCP Integrations
JOBGPT_API_KEY=
JOBGPT_API_URL=https://6figr.com

# Greenhouse public job board (only needed when JOB_SOURCE=greenhouse).
# Board token = the slug on the company's careers URL: boards.greenhouse.io/<board_token>
GREENHOUSE_BOARD=
GREENHOUSE_API_URL=https://boards-api.greenhouse.io/v1

# Lever public job postings (only needed when JOB_SOURCE=lever).
# Company = the slug on the careers site: jobs.lever.co/<company> (e.g. lever)
LEVER_COMPANY=
LEVER_API_URL=https://api.lever.co/v0

# Ashby public posting API (only needed when JOB_SOURCE=ashby).
# Board = the slug on the careers site: jobs.ashbyhq.com/<board>
ASHBY_BOARD=
ASHBY_API_URL=https://api.ashbyhq.com/posting-api

# Remotive remote-jobs feed (documented public API, no key). Remote-only.
# Attribution: link back to Remotive and credit it as the source when surfacing.
REMOTIVE_API_URL=https://remotive.com/api

# Jobicy remote-jobs feed (documented public API, no key). Remote-only.
JOBICY_API_URL=https://jobicy.com/api/v2

# Adzuna (optional; free tier needs an account and ~1,000 calls/month).
# Country code default 'in' (India). Affiliate redirect apply URLs.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
ADZUNA_API_URL=https://api.adzuna.com/v1/api

# Board discovery catalog (written by `python -m job_agent discover`, read by
# `python -m job_agent run --discover`). Data file, gitignored.
# DISCOVERY_CATALOG_PATH=data/boards.json

# LLM provider for AI-dependent features (tailoring, drafting, semantic matching).
# none = deterministic-only mode. First-class optional local option: ollama
LLM_PROVIDER=none

# Ollama (used only when LLM_PROVIDER=ollama and a local daemon is running)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2